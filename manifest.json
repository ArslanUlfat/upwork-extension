{
  "manifest_version": 3,
  "name": "Upwork Rails Job Scraper",
  "version": "1.0.0",
  "description": "Extract and display Rails-related job listings from Upwork",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.upwork.com/*",
    "https://hooks.slack.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Upwork Rails Scraper"
  },
  "content_scripts": [
    {
      "matches": ["https://www.upwork.com/nx/search/jobs*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}