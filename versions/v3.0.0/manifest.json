{
  "manifest_version": 3,
  "name": "Upwork Job Scraper - AI Master",
  "version": "3.0.0",
  "description": "Advanced AI-powered Upwork job scraper with custom styling, smart filtering, and automated proposal generation",
  
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "alarms",
    "scripting"
  ],
  
  "host_permissions": [
    "https://www.upwork.com/*",
    "https://api.slack.com/*"
  ],
  
  "background": {
    "service_worker": "../../shared/background.js",
    "type": "module"
  },
  
  "content_scripts": [
    {
      "matches": ["https://www.upwork.com/*"],
      "js": ["../../shared/content.js"],
      "css": ["popup-ai-master.css"],
      "run_at": "document_end"
    }
  ],
  
  "action": {
    "default_popup": "popup-ai-master.html",
    "default_title": "Upwork Job Scraper - AI Master",
    "default_icon": {
      "16": "../../icons/icon16.png",
      "48": "../../icons/icon48.png",
      "128": "../../icons/icon128.png"
    }
  },
  
  "icons": {
    "16": "../../icons/icon16.png",
    "48": "../../icons/icon48.png",
    "128": "../../icons/icon128.png"
  },
  
  "web_accessible_resources": [
    {
      "resources": [
        "popup-ai-master.css",
        "popup-ai-master.js",
        "../../shared/*.js"
      ],
      "matches": ["https://www.upwork.com/*"]
    }
  ],
  
  "options_page": "popup-ai-master.html",
  
  "commands": {
    "find-jobs": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Find new jobs"
    },
    "toggle-auto-apply": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Toggle auto-apply feature"
    }
  }
}
