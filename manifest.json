{
  "manifest_version": 3,
  "name": "🪄 Magic Upwork Assistant",
  "version": "2.0.0",
  "version_name": "Magic Stick Edition",
  "description": "AI-powered job analysis, smart filtering, auto-apply, and market insights for Upwork freelancers",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "background"
  ],
  "host_permissions": [
    "https://www.upwork.com/*",
    "https://hooks.slack.com/*"
  ],
  "action": {
    "default_popup": "versions/v2.0.0/popup-pro.html",
    "default_title": "Magic Upwork Assistant"
  },
  "content_scripts": [
    {
      "matches": ["https://www.upwork.com/nx/search/jobs*"],
      "js": ["shared/content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "shared/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "shared/version-config.js",
        "shared/version-display.js",
        "shared/version-styles.css",
        "versions/v1.0.0/popup-basic.html",
        "versions/v1.0.0/popup-basic.css",
        "versions/v1.0.0/popup-basic.js",
        "versions/v2.0.0/popup-pro.html",
        "versions/v2.0.0/popup-pro.css",
        "versions/v2.0.0/popup-pro.js"
      ],
      "matches": ["https://www.upwork.com/*"]
    }
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}